OPENCLAW_IMAGE=openclaw-api-consultant:local
OPENCLAW_GATEWAY_PORT=18889
OPENCLAW_BRIDGE_PORT=18890
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_TZ=Asia/Shanghai
OPENCLAW_DISABLE_BONJOUR=1

# 必填：Gateway 管理口令，用 openssl rand -hex 32 生成
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_STRONG_RANDOM_TOKEN

# 必填：Hooks Token，不能与 Gateway Token 相同
OPENCLAW_HOOKS_TOKEN=REPLACE_WITH_ANOTHER_STRONG_RANDOM_TOKEN

# 模型：按供应商在 openclaw.json 中添加 models.providers，并设置模型 ID
# 示例: deepseek/deepseek-chat, minimax/MiniMax-M2.7, anthropic/claude-opus-4-6
OPENCLAW_MODEL_PRIMARY=REPLACE_WITH_MODEL_PRIMARY

# 模型供应商 API Key（按实际供应商设置环境变量名）
# 示例: DEEPSEEK_API_KEY, MINIMAX_API_KEY, ANTHROPIC_API_KEY

# 沙箱数据目录：宿主机上 workspace 下 data/ 的绝对路径
# Agent 在沙箱内通过 /data/ 读取业务资料，系统文件不可见
OPENCLAW_HOST_DATA_DIR=/home/ubuntu/openclaw-api-consultant/state/workspace/consultant-main/data
